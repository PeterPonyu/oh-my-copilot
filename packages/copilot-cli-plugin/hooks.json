{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash packages/copilot-cli-plugin/scripts/log-session-start.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash packages/copilot-cli-plugin/scripts/pre-tool-policy-gate.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash packages/copilot-cli-plugin/scripts/post-tool-audit.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash packages/copilot-cli-plugin/scripts/session-end-audit.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
